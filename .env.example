# Privatna stranica /izracun-cijene/
PREVODITELJ_LOZINKA=
# Dugi nasumični niz (npr. `openssl rand -hex 32`) za potpisivanje kolačića prijave
SESSION_SECRET=

# Supabase: Project URL (Project Settings → Data API) i tajni ključ sb_secret_… (Project Settings → API Keys → Secret keys)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Resend (API Keys) – obavijesti o novim upitima
RESEND_API_KEY=
# Na koju adresu stižu obavijesti (zadano mario.sercer@gmail.com)
OBAVIJEST_EMAIL=
# Pošiljatelj; bez potvrđene domene na Resendu mora ostati onboarding@resend.dev
OBAVIJEST_POSILJATELJ=

# Cloudflare Turnstile (neobavezno, zaštita od spama)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Places API – recenzije na početnoj (osvježavanje jednom dnevno)
GOOGLE_PLACES_API_KEY=

# Adobe PDF Services (pretvaranje u Word na /izracun-cijene/)
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
# "ew1" za europsku regiju; prazno = SAD
ADOBE_REGIJA=
# Mjesečni broj operacija (besplatni paket: 500)
ADOBE_MJESECNI_LIMIT=
